# Application Environment Configuration
APP_ENV=development
APP_NAME=AI-Job-Intelligence
APP_DEBUG=true
LOG_LEVEL=INFO

# Database Connection
# In local development without Postgres running, defaults to SQLite:
DATABASE_URL=sqlite+aiosqlite:///./ai_job_intelligence.db
# In production (e.g. Aiven free tier PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname?ssl=require

# HTTP Collector Settings
COLLECTOR_TIMEOUT_SECONDS=15
COLLECTOR_MAX_RETRIES=3
COLLECTOR_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36

# Scheduler Settings
SCHEDULER_ENABLED=false
COLLECTION_INTERVAL_HOURS=6

# LLM Gateway Configuration (Free Tiers & Local Fallback)
# 1. OpenRouter (Free models: deepseek/deepseek-chat:free, etc.)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# 2. Local Ollama Fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
